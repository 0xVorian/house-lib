#!/usr/bin/env bash
# House stack pre-push gate — runs scripts/ci-local.sh before push.
# Bypass: SKIP_CI_HOOKS=1 git push

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if [[ "${SKIP_CI_HOOKS:-}" == "1" ]]; then
  echo "pre-push: SKIP_CI_HOOKS=1 — skipping local checks"
  exit 0
fi

if [[ ! -f scripts/ci-local.sh ]]; then
  echo "pre-push: no scripts/ci-local.sh — skipping"
  exit 0
fi

echo "pre-push: running scripts/ci-local.sh ..."
bash scripts/ci-local.sh
echo "pre-push: checks passed"
